# Copie para .env e ajuste os valores: cp .env.example .env

# Banco de dados (usado pelos serviços db e api no compose). "fako" só serve para desenvolvimento.
POSTGRES_USER=fako
POSTGRES_PASSWORD=fako
POSTGRES_DB=fako
# Porta do banco no host (127.0.0.1). Troque (ex.: 5433) se já houver um PostgreSQL local na 5432.
POSTGRES_HOST_PORT=5432

# Autenticação (obrigatório): a API não sobe sem um segredo de 32 bytes ou mais. Gere um com
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# e nunca reaproveite o de outro ambiente. Trocar o segredo invalida os logins abertos.
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440

# Origens permitidas no CORS (lista JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Classificador de veracidade: "fake" funciona sem modelo. O modelo publicado é o "conjunto"
# (dois BERTimbau em ONNX, sem PyTorch na API): `make modelo` baixa da Release para
# MODELS_DIR/atual. "bert" e "referencia" leem um modelo único na mesma pasta.
CLASSIFICADOR_PROVIDER=fake
MODELS_DIR=/app/models
# Mostra ao jogador o palpite do classificador depois da resposta (true/false).
CLASSIFICADOR_NO_JOGO=false

# Notícias externas que viram rascunhos de afirmações (POST /admin/news/import).
# "fake" funciona sem chave; "gnews" (manchetes, só verdadeiras) pede uma chave gratuita em
# https://gnews.io; "agenciabrasil" (manchetes da Agência Brasil, só verdadeiras) não pede chave;
# "factcheck" (checagens de agências, com falsas) usa a FACTCHECK_API_KEY abaixo; "boatos"
# (boatos desmentidos pelo Boatos.org, só falsos) não pede chave.
# Juntos, para ter falsas e verdadeiras: NOTICIAS_PROVIDER=factcheck,boatos,gnews,agenciabrasil
NOTICIAS_PROVIDER=fake
NOTICIAS_API_KEY=
# Notícias entram já validadas, sem revisão humana (true/false): checagens com o rótulo
# da agência, manchetes como verdadeiras.
NOTICIAS_PUBLICAR_DIRETO=false
# Descarta checagens sobre política e eleição (true/false).
NOTICIAS_SEM_POLITICA=false
# Rotina diária (serviço agendador-api, horários em api/crontab): quantas notícias importar por
# dia (metade falsas e metade verdadeiras, no máximo), em que categoria, e por quantos dias ficam no banco (depois são apagadas; as que algum
# jogador respondeu são arquivadas).
NOTICIAS_POR_DIA=50
NOTICIAS_CATEGORIA=conhecimentos-gerais
NOTICIAS_RETENCAO_DIAS=30

# Google Fact Check Tools API (NOTICIAS_PROVIDER=factcheck).
# Chave gratuita no Google Cloud:
# crie um projeto, ative "Fact Check Tools API" e gere uma chave em Credenciais.
FACTCHECK_API_KEY=

# LLM (Qwen pelo Ollama, no host): geração de questões, extração de afirmações (a entrada do
# classificador em conjunto) e o "Por quê?" do jogo (api/app/ml/llm.py). Endpoint compatível com
# a API de chat da OpenAI (Ollama, proxy do LiteLLM ou provedor hospedado). Instalar o Ollama e
# baixar o modelo: ollama pull qwen3:8b
# LLM_PROVIDER: "fake" funciona sem LLM; "openai" usa LLM_BASE_URL e LLM_MODEL.
# LLM_MODEL com a versão fixa: é o modelo com que a afirmação extraída foi avaliada.
# LLM_EXTRA_BODY: JSON opcional somado ao pedido, ex.: {"enable_thinking": false} no Qwen3
# (o nome da opção depende do provedor; no Ollama, {"reasoning_effort": "none"}).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_EXTRA_BODY={"reasoning_effort": "none"}
LLM_PROVIDER=fake
# Opcionais da API: temperatura (0,2 a 0,3), tempo limite por chamada em segundos e se o JSON
# Schema da saída vai em response_format (false se o provedor recusar).
# LLM_TEMPERATURA=0.2
# LLM_TEMPO_LIMITE=120
# LLM_ESQUEMA=true
