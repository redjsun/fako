# Copie para .env e ajuste os valores: cp .env.example .env

# Banco de dados (usado pelos serviços db e api no compose). "fako" só serve para desenvolvimento.
POSTGRES_USER=fako
POSTGRES_PASSWORD=fako
POSTGRES_DB=fako
# Porta do banco no host (127.0.0.1). Troque (ex.: 5433) se já houver um PostgreSQL local na 5432.
POSTGRES_HOST_PORT=5432

# Autenticação (obrigatório): a API não sobe sem um segredo de 32 bytes ou mais. Gere um com
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# e nunca reaproveite o de outro ambiente. Trocar o segredo invalida os logins abertos.
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440

# Origens permitidas no CORS (lista JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Inteligência Artificial: só "fake" por enquanto (outro valor faz as rotas de IA responderem 503)
AI_PROVIDER=fake
# Dispositivo do BERTimbau Y1/Y2 de POST /ai/analyze (cpu ou cuda)
AI_DEVICE=cpu

# Classificador de veracidade: "fake" funciona sem modelo; os treinados ficam em MODELS_DIR/atual
# Para a referência TF-IDF: CLASSIFICADOR_PROVIDER=referencia e make publicar.
CLASSIFICADOR_PROVIDER=fake
MODELS_DIR=/app/models
# Mostra ao jogador o palpite do classificador depois da resposta (true/false).
CLASSIFICADOR_NO_JOGO=false

# Notícias externas que viram rascunhos de afirmações (POST /admin/news/import).
# "fake" funciona sem chave; "gnews" (manchetes, só verdadeiras) pede uma chave gratuita em
# https://gnews.io; "factcheck" (checagens de agências, com falsas) usa a FACTCHECK_API_KEY abaixo.
# Os dois juntos, para ter falsas e verdadeiras: NOTICIAS_PROVIDER=factcheck,gnews
NOTICIAS_PROVIDER=fake
NOTICIAS_API_KEY=
# Notícias entram já validadas, sem revisão humana (true/false): checagens com o rótulo
# da agência, manchetes como verdadeiras.
NOTICIAS_PUBLICAR_DIRETO=false
# Descarta checagens sobre política e eleição (true/false).
NOTICIAS_SEM_POLITICA=false

# Google Fact Check Tools API (pesquisa/dados/coletar_factcheck.py e NOTICIAS_PROVIDER=factcheck).
# Chave gratuita no Google Cloud:
# crie um projeto, ative "Fact Check Tools API" e gere uma chave em Credenciais.
FACTCHECK_API_KEY=

# LLM de extração de alegações (Qwen pelo Ollama, no host): coleta diária de notícias e
# padronização do treino (pesquisa/ml/padronizar.py). Endpoint compatível com a API de chat da
# OpenAI. Instalar o Ollama e baixar o modelo: ollama pull qwen3:8b
# LLM_MODEL com a versão fixa: trocar o modelo refaz o cache da padronização.
# LLM_EXTRA_BODY: JSON opcional somado ao pedido, ex.: {"enable_thinking": false} no Qwen3
# (o nome da opção depende do provedor; no Ollama, {"reasoning_effort": "none"}).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_EXTRA_BODY={"reasoning_effort": "none"}

# Jupyter Lab (make eda): token de acesso. Vazio, o Jupyter gera um e mostra no log.
JUPYTER_TOKEN=
